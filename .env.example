# ==============================================================================
# Environment Variables Example Configuration
# Copy this file to .env and fill in your actual production values.
# NEVER commit .env to version control.
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# Security & Authentication
# Generate a secure key in node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_this_to_a_secure_random_string_in_production
SESSION_EXPIRY=24h

# Admin Credentials (Used to seed or update the local admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure2026!

# Document Storage
STORAGE_DIR=./storage/private_documents
MAX_FILE_SIZE_MB=15

# Social Profile Integrations
GITHUB_USERNAME=harsha895155
GITHUB_TOKEN=
LINKEDIN_URL=https://www.linkedin.com/in/harshavardhanreddy-280392298/
UNSTOP_URL=
CREDLY_URL=https://www.credly.com/users/harsha10003/badges/credly

# AI Portfolio Agent Settings
# Configurable AI Providers: 'gemini' (Recommended), 'openai', or 'local'
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
# Optional Cloud API Keys (If left empty, system automatically uses high-precision local semantic AI engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
